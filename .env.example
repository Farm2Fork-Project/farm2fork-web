# Browser-visible, non-secret API base. The current backend routes use /api, not /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_FIREBASE_API_KEY=
# Use the exact web authority that serves this app, for example localhost:3001
# locally and the deployed web host in production. Do not use firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
