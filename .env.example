# Browser-visible, non-secret API base. The current backend routes use /api, not /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local HTTP derives Firebase's hosted auth domain from
# NEXT_PUBLIC_FIREBASE_PROJECT_ID and uses signInWithPopup. Set this value to
# the exact HTTPS web authority only for deployed redirect authentication.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional Google Maps JavaScript API key (restrict it to your web origins).
# Without it, farm and drop-off pins are set from the browser's location.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Local mock gateways and settlement controls only; ignored in production.
# Backend PAYMENT_SIMULATOR_ENABLED must also be true.
NEXT_PUBLIC_PAYMENT_SIMULATOR_ENABLED=false

# Public Web Push certificate key from Firebase Console > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# SEO. NEXT_PUBLIC_SITE_URL must be the deployed HTTPS origin (no trailing
# slash); canonical URLs, the sitemap, Open Graph and JSON-LD all use it, and
# it is baked in at build time. The contact email enables /contact and the
# Organization contactPoint. Verification codes come from Google Search
# Console and Bing Webmaster Tools.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
