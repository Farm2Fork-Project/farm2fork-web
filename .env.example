# Browser-visible, non-secret API base. The current backend routes use /api, not /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local HTTP derives Firebase's hosted auth domain from
# NEXT_PUBLIC_FIREBASE_PROJECT_ID and uses signInWithPopup. Set this value to
# the exact HTTPS web authority only for deployed redirect authentication.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Optional Google Maps JavaScript API key (restrict it to your web origins).
# Without it, farm and drop-off pins are set from the browser's location.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
